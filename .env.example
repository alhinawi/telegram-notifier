# Copy to .env; never commit credentials. Or use TELEGRAM_NOTIFIER_CONFIG=/private/path.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
NOTIFICATION_LANGUAGE=en

# Explicit scan/allowed roots. No automatic home-directory scanning.
WORKSPACE_DIRS=~/workspace
AI_AGENT_CLI=gemini
# Optional JSON string array, never shell syntax:
AI_AGENT_ARGS=[]
TASK_TIMEOUT=600
# Breaking security default in v2: local opt-in required to execute prompts.
ALLOW_REMOTE_EXECUTION=false
# For a group chat, explicitly allow individual numeric sender IDs:
# TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Ignore old queued messages (seconds):
MAX_UPDATE_AGE=120
