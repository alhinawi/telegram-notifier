# Telegram Bot Credentials
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get TELEGRAM_CHAT_ID by running `npm run detect-chat-id` or via @userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# Notification & Listener Language (en | ar-eg | ar)
NOTIFICATION_LANGUAGE=ar-eg

# Two-Way Bridge / Interactive Listener Settings
# Workspace directories to scan for projects (comma-separated, supports ~)
WORKSPACE_DIRS=~/workspace/personal,~/workspace,~/Projects

# Default AI Agent CLI command to execute prompts (e.g. gemini, claude, aider)
AI_AGENT_CLI=gemini

# Task execution timeout in seconds (default: 600 = 10 minutes)
TASK_TIMEOUT=600
